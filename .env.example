# Django
DJANGO_SETTINGS_MODULE=tms_project.settings
SECRET_KEY=replace-with-a-secure-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database and uploaded files
SQLITE_PATH=backend/db.sqlite3
MEDIA_ROOT=backend/media
DATABASE_SSL=False
# DATABASE_URL=postgresql://user:password@host:5432/database

# Optional MySQL configuration
# DB_ENGINE=mysql
# MYSQL_DATABASE=tms_db
# MYSQL_USER=bebin1234
# MYSQL_PASSWORD=
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# Deployment/bootstrap
AUTO_CREATE_DB=0
AUTO_MIGRATE=0
AUTO_SEED_DATA=0

# Frontend/Vite
VITE_API_BASE_URL=/api/
VITE_DEV_API_URL=http://127.0.0.1:8000
VITE_BASE_PATH=/

# Optional external APIs
GROK_API_KEY=your_groq_api_key_here

# GROQ_API_KEY is also supported for Groq console keys.
